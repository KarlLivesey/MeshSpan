{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "Public error envelope that never includes raw untrusted values.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error category.",
            "oneOf": [
              {
                "const": "unauthenticated",
                "description": "Authentication was absent or invalid.",
                "type": "string"
              },
              {
                "const": "forbidden",
                "description": "The authenticated caller lacks current authority.",
                "type": "string"
              },
              {
                "const": "invalid_request",
                "description": "The message did not satisfy the public contract.",
                "type": "string"
              },
              {
                "const": "operation_conflict",
                "description": "An idempotency key was reused with different canonical input.",
                "type": "string"
              },
              {
                "const": "busy",
                "description": "Work was rejected by a bounded admission policy.",
                "type": "string"
              },
              {
                "const": "internal_contract",
                "description": "An outgoing response failed its own contract.",
                "type": "string"
              }
            ]
          },
          "issues": {
            "description": "Independently actionable field failures, capped at the trust boundary.",
            "items": {
              "additionalProperties": false,
              "description": "A bounded field-specific validation issue.",
              "properties": {
                "constraint": {
                  "description": "Stable violated-constraint label.",
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "path": {
                  "description": "JSON Pointer to the rejected field or collection element.",
                  "maxLength": 256,
                  "type": "string"
                }
              },
              "required": [
                "path",
                "constraint"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "type": "array"
          },
          "message": {
            "description": "Plain bounded description safe to show to the caller.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "operation_id": {
            "description": "Mutation operation identifier, or null for requests without one.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "description": "Server request identifier for support correlation.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "operation_id",
          "issues"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "CreateMeshSetupRequest": {
        "additionalProperties": false,
        "description": "One exact request to create the first mesh on an unclaimed daemon.",
        "properties": {
          "administrator_name": {
            "description": "Human-readable first administrator name.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x2f\\x7f\\\\]+$",
            "type": "string"
          },
          "claim": {
            "description": "High-entropy single-use claim printed or written by the local daemon.",
            "maxLength": 115,
            "minLength": 115,
            "pattern": "^meshspan-claim-v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$",
            "type": "string",
            "writeOnly": true
          },
          "host_name": {
            "description": "Human-readable physical host name.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x2f\\x7f\\\\]+$",
            "type": "string"
          },
          "mesh_name": {
            "description": "Human-readable mesh name.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x2f\\x7f\\\\]+$",
            "type": "string"
          },
          "node_name": {
            "description": "Human-readable daemon-node name.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x2f\\x7f\\\\]+$",
            "type": "string"
          },
          "operation_id": {
            "description": "Client-generated idempotency identity.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "claim",
          "mesh_name",
          "administrator_name",
          "host_name",
          "node_name"
        ],
        "title": "CreateMeshSetupRequest",
        "type": "object"
      },
      "CreateMeshSetupResponse": {
        "additionalProperties": false,
        "description": "Successful, committed first-mesh creation result.",
        "properties": {
          "api_key": {
            "description": "One-time presentation of the first administrator's ordinary API key.",
            "maxLength": 113,
            "minLength": 113,
            "pattern": "^meshspan-key-v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$",
            "type": "string",
            "x-meshspan-sensitive": true
          },
          "mesh_id": {
            "description": "Stable UUID of the created mesh.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "node_id": {
            "description": "Stable UUID of the first daemon node.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "operation_id": {
            "description": "Exact idempotency identity whose result was resolved.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "mesh_id",
          "node_id",
          "api_key"
        ],
        "title": "CreateMeshSetupResponse",
        "type": "object"
      },
      "CreateSessionRequest": {
        "additionalProperties": false,
        "description": "Input for exchanging accepted authentication proofs for a session.",
        "properties": {
          "additional_factor": {
            "anyOf": [
              {
                "description": "Optional recovery or step-up proof supplied beside the primary method.",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "Current time-based one-time code.",
                    "properties": {
                      "code": {
                        "description": "Six-to-eight digit TOTP value.",
                        "maxLength": 8,
                        "minLength": 6,
                        "type": "string",
                        "writeOnly": true
                      },
                      "method": {
                        "const": "totp",
                        "type": "string"
                      }
                    },
                    "required": [
                      "method",
                      "code"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "description": "One single-use recovery code.",
                    "properties": {
                      "code": {
                        "description": "Opaque recovery code consumed atomically on success.",
                        "maxLength": 128,
                        "minLength": 8,
                        "type": "string",
                        "writeOnly": true
                      },
                      "method": {
                        "const": "recovery_code",
                        "type": "string"
                      }
                    },
                    "required": [
                      "method",
                      "code"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional TOTP or recovery-code proof when policy requires another factor."
          },
          "authentication": {
            "description": "Primary API-key or passkey proof. It identifies the principal server-side.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "One ordinary login-capable `MeshSpan` API key.",
                "properties": {
                  "method": {
                    "const": "api_key",
                    "type": "string"
                  },
                  "secret": {
                    "description": "Opaque API-key secret. The key identity and scopes are resolved server-side.",
                    "maxLength": 512,
                    "minLength": 16,
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "method",
                  "secret"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "description": "One complete assertion bound to a previously issued `WebAuthn` challenge.",
                "properties": {
                  "authenticator_data": {
                    "description": "Base64url-encoded authenticator data.",
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string",
                    "writeOnly": true
                  },
                  "challenge_id": {
                    "description": "Server-issued challenge identity consumed exactly once.",
                    "maxLength": 36,
                    "minLength": 36,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string"
                  },
                  "client_data_json": {
                    "description": "Base64url-encoded `WebAuthn` client data JSON.",
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string",
                    "writeOnly": true
                  },
                  "credential_id": {
                    "description": "Base64url-encoded `WebAuthn` credential identity.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string",
                    "writeOnly": true
                  },
                  "method": {
                    "const": "passkey",
                    "type": "string"
                  },
                  "signature": {
                    "description": "Base64url-encoded assertion signature.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string",
                    "writeOnly": true
                  },
                  "user_handle": {
                    "description": "Base64url-encoded user handle, null when the authenticator omitted it.",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": [
                      "string",
                      "null"
                    ],
                    "writeOnly": true
                  }
                },
                "required": [
                  "method",
                  "challenge_id",
                  "credential_id",
                  "client_data_json",
                  "authenticator_data",
                  "signature"
                ],
                "type": "object"
              }
            ]
          },
          "client_label": {
            "description": "Optional client label: omitted means unchanged and null means clear.",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "type": [
              "string",
              "null"
            ]
          },
          "operation_id": {
            "description": "Client-generated idempotency key.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "remember": {
            "description": "Whether the caller requests the policy's longer-lived session profile.",
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "authentication",
          "remember"
        ],
        "title": "CreateSessionRequest",
        "type": "object"
      },
      "CreateSessionResponse": {
        "additionalProperties": false,
        "description": "Successful session creation response.",
        "properties": {
          "assurance": {
            "description": "Assurance reached by the accepted authentication factors.",
            "oneOf": [
              {
                "const": "single_factor",
                "description": "One accepted authentication factor.",
                "type": "string"
              },
              {
                "const": "multi_factor",
                "description": "Multiple independent accepted factors.",
                "type": "string"
              },
              {
                "const": "recent_step_up",
                "description": "A recent privileged step-up ceremony.",
                "type": "string"
              }
            ]
          },
          "expires_at_epoch_micros": {
            "description": "Authoritative UTC instant as epoch microseconds.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "operation_id": {
            "description": "The operation whose durable outcome this response represents.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "session_id": {
            "description": "Newly created session identifier.",
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "session_id",
          "expires_at_epoch_micros",
          "assurance"
        ],
        "title": "CreateSessionResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Bounded anonymous health response.",
        "properties": {
          "api_version": {
            "description": "Resolved rolling API label.",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^latest$",
            "type": "string"
          },
          "schema_digest": {
            "description": "Digest of the exact `OpenAPI` document served by this process.",
            "maxLength": 71,
            "minLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "description": "Current readiness state.",
            "oneOf": [
              {
                "const": "starting",
                "description": "The process is initialising and cannot yet serve normal traffic.",
                "type": "string"
              },
              {
                "const": "ready",
                "description": "The process can serve its declared API contract.",
                "type": "string"
              },
              {
                "const": "degraded",
                "description": "The process is serving traffic with a declared impaired capability.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "status",
          "api_version",
          "schema_digest"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SetupStatusResponse": {
        "additionalProperties": false,
        "description": "Cheap anonymous first-start status safe for local-network discovery.",
        "properties": {
          "state": {
            "description": "Current coarse setup state; this response never includes claim material.",
            "oneOf": [
              {
                "const": "claim_required",
                "description": "A locally presented claim bundle is required to create or join a swarm.",
                "type": "string"
              },
              {
                "const": "configuring",
                "description": "A claimed create/join operation is durably incomplete and will resume.",
                "type": "string"
              },
              {
                "const": "configured",
                "description": "Initial swarm creation or enrolment has completed.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "state"
        ],
        "title": "SetupStatusResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "license": {
      "identifier": "GPL-2.0-only",
      "name": "GNU General Public License v2.0 only"
    },
    "title": "MeshSpan public API",
    "version": "latest"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Process readiness",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Outgoing contract failure",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Read bounded process readiness",
        "x-meshspan-access": "anonymous"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "x-meshspan-intentionally-extensible": true
                }
              }
            },
            "description": "This exact OpenAPI 3.1 document",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Read this exact API contract",
        "x-meshspan-access": "anonymous"
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            },
            "description": "Authenticated session created",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Malformed or structurally invalid request",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Authentication rejected",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Operation identifier conflict",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Bounded admission rejected the request",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Outgoing contract failure",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Start a bounded authentication ceremony",
        "x-meshspan-access": "anonymous",
        "x-meshspan-idempotency": "operation-id-and-canonical-request-digest"
      }
    },
    "/setup/meshes": {
      "post": {
        "operationId": "createMeshSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMeshSetupRequest"
              }
            }
          },
          "description": "First-mesh setup",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMeshSetupResponse"
                }
              }
            },
            "description": "Committed first mesh",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid request",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "First-boot claim rejected",
            "headers": {
              "MeshSpan-API-Schema": {
                "required": true,
                "schema": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "MeshSpan-API-Version": {
                "required": true,
                "schema": {
                  "const": "latest",
