{
  "name": "meshspan-workspace",
  "private": true,
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11.19 <12"
  },
  "scripts": {
    "build:daemon": "node scripts/build-daemon.mjs",
    "package:local": "node scripts/package-local.mjs",
    "check": "node scripts/check.mjs",
    "check:advisories": "cargo deny check advisories && pnpm audit",
    "check:dependency-update": "pnpm check:advisories && pnpm check",
    "check:licences": "cargo deny check licenses && node scripts/check-javascript-licences.mjs",
    "check:stage3-adversarial": "node scripts/check-stage3-adversarial.mjs",
    "check:dns-providers": "node scripts/check-dns-providers.mjs",
    "check:generated": "node scripts/verify-generated.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "web:format": "pnpm --filter @meshspan/web format",
    "web:lint": "pnpm --filter @meshspan/eslint check",
    "web:test": "pnpm --filter @meshspan/web test",
    "web:typecheck": "pnpm --filter @meshspan/web typecheck"
  }
}
